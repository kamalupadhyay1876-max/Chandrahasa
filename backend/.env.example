# Local server settings. Copy this file to .env and change SECRET.
PORT=3000
NODE_ENV=development
SECRET=replace-with-unique-random-32-plus-characters
DATA_PATH=./data/chandrahasa.db
# Optional email integration (reset email only)
RESEND_API_KEY=
MAIL_FROM=Chandrahasa <hello@chandrahasa.com>
# Razorpay live/test credentials (keys remain server-side; publishable key used at checkout).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional monitoring
# Shiprocket API account credentials; pickup location name as configured in account
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional monitoring
SENTRY_DSN=
# Optional Supabase Storage (catalog media). Storage upload UI is not yet wired.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never expose this in client/browser code. Only use server-side if implementing upload workflows.
SUPABASE_SERVICE_ROLE_KEY=

# Optional multimodal visual search and semantic catalogue recommendations
OPENAI_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-3-small
VISION_MODEL=gpt-4o-mini

# Seller marketplace: provider webhook must HMAC-SHA256 sign raw JSON body using this secret.
SELLER_KYC_WEBHOOK_SECRET=
# Razorpay Route must be separately approved/activated by Razorpay for this merchant.
RAZORPAY_ROUTE_ENABLED=false
# Optional: after full sandbox sign-off, trigger Route transfer automatically on delivered orders.
AUTO_ROUTE_PAYOUTS=false
AUTO_ROUTE_PAYOUT_DELAY_HOURS=168

# Seller marketplace carrier credential encryption (use a dedicated random 32+ character secret).
SELLER_CARRIER_ENCRYPTION_KEY=

# Optional durable event delivery to a private automation endpoint (HTTPS only)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
